{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend del sistema ELECTRONOVA",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "start": "cd backend && npm start",
    "seed": "cd backend && npm run seed",
    "clear": "cd backend && npm run clear"
  },
  "keywords": [
    "electronova",
    "catalogo",
    "productos-electricos",
    "api"
  ],
  "author": "ELECTRONOVA",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.9",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14"
  }
}
